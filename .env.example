# Public browser key. Restrict it in Google Cloud to your production host and Map Tiles API.
VITE_GOOGLE_MAPS_API_KEY=
# Optional fallback terrain token if you choose to use Cesium ion.
VITE_CESIUM_ION_TOKEN=

# Legacy typo compatibility (v7 only; prefer VITE_CESIUM_ION_TOKEN)
VITE_CESIU_ION_TOKEN=
