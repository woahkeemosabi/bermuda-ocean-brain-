# Public browser key. Restrict it in Google Cloud to your production host and Map Tiles API.
VITE_GOOGLE_MAPS_API_KEY=

# Optional fallback terrain token if you choose to use Cesium ion.
VITE_CESIUM_ION_TOKEN=
# Legacy typo compatibility.
VITE_CESIU_ION_TOKEN=

# Server-only AISStream credential. Configure this in Vercel; never expose it with a VITE_ prefix.
AISSTREAM_API_KEY=

# Vercel Blob authentication is supplied automatically when a private Blob store is connected
# to the Vercel project (OIDC on new stores; older stores may expose BLOB_READ_WRITE_TOKEN).
